    "url": "https://github.com/marcelinosandroni/opencode-model-usage/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelinosandroni/opencode-model-usage.git"
  },
  "license": "MIT",
  "author": "Marcelino Sandroni",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "index.ts",
    "src"
  ],
  "scripts": {
