    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/theme": "2.4.2",
    "@opentui/core": "0.9.9",
    "@opentui/solid": "0.9.4",
    "@types/node": "^26.6.11",
    "solid-js": "1.9.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
