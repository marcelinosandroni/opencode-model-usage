{
  "name": "opencode-model-usage",
  "version": "0.1.0",
  "description": "OpenCode V2 plugin that tracks model usage: requests per minute, tokens, cost and latency per turn and session",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "usage",
    "tokens",
    "rpm",
    "metrics",
    "typescript"
  ],
  "homepage": "https://github.com/marcelinosandroni/opencode-model-usage#readme",
